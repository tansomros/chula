          <ReportItems>
            <Textbox Name="ReportTitle">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>รายงานการรับนิสิตฝึกปฏิบัติงานวิชาชีพเภสัชกรรม</Value>
                      <Style>
