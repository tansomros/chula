    <script src="components/datepicker/bootstrap-datepicker.th.js"></script>  

    <script>
        $(function () {   
            var d = new Date();
		    var toDay = d.getDate() + '/' + (d.getMonth() + 1) + '/'+ (d.getFullYear() + 543);
            $("#datepicker-th").datepicker({ dateFormat: 'dd/mm/yyyy', isBuddhist: true, defaultDate: toDay,autoclose: true });
        });
    </script>

