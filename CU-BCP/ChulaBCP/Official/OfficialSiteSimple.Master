      <!-- logo for regular state and mobile devices -->
      <span class="logo-lg"><img src="images/logo.png"  width="40" align="absmiddle">&nbsp;<b>IM</b>SUT</span>
    </a>
    <!-- Header Navbar: style can be found in header.less -->
